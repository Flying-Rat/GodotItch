[configuration]

entry_symbol = "godotitch_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

macos.release = "res://addons/godot_itch/bin/macos/libgodotitch.macos.template_release.framework"
ios.release = "res://addons/godot_itch/bin/ios/libgodotitch.ios.template_release.xcframework"
windows.release.x86_32 = "res://addons/godot_itch/bin/windows/libgodotitch.windows.template_release.x86_32.dll"
windows.release.x86_64 = "res://addons/godot_itch/bin/windows/libgodotitch.windows.template_release.x86_64.dll"
linux.release.x86_64 = "res://addons/godot_itch/bin/linux/libgodotitch.linux.template_release.x86_64.so"
linux.release.arm64 = "res://addons/godot_itch/bin/linux/libgodotitch.linux.template_release.arm64.so"
linux.release.rv64 = "res://addons/godot_itch/bin/linux/libgodotitch.linux.template_release.rv64.so"
android.release.x86_64 = "res://addons/godot_itch/bin/android/libgodotitch.android.template_release.x86_64.so"
android.release.arm64 = "res://addons/godot_itch/bin/android/libgodotitch.android.template_release.arm64.so"

[dependencies]
ios.debug = {
    "res://addons/godot_itch/bin/ios/libgodot-cpp.ios.template_debug.xcframework": ""
}
ios.release = {
    "res://addons/godot_itch/bin/ios/libgodot-cpp.ios.template_release.xcframework": ""
}